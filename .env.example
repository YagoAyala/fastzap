# ─────────────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3333

# ─────────────────────────────────────────────────
# Autenticação
# ─────────────────────────────────────────────────
# Token Bearer para autenticar chamadas à API
API_TOKEN=seu-token-aqui

# Token separado para acesso à página do QR code no browser
QR_ACCESS_TOKEN=seu-token-qr-aqui

# ─────────────────────────────────────────────────
# Banco de dados (PostgreSQL)
# ─────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# ─────────────────────────────────────────────────
# WhatsApp
# ─────────────────────────────────────────────────
# Número máximo de tentativas de reconexão automática
MAX_RETRIES=5

# Intervalo base entre tentativas de reconexão (em ms)
# O intervalo real é RECONNECT_INTERVAL_MS * número_da_tentativa (max 60s)
RECONNECT_INTERVAL_MS=5000

# Diretório onde os arquivos de autenticação das sessões são salvos
SESSIONS_DIR=./sessions

# Prazo (ms) até declarar `undelivered` uma mensagem que o WhatsApp aceitou e
# nunca confirmou entrega. Esse desfecho não gera evento nenhum no Baileys: sem
# este vigia, "entregou" e "sumiu no caminho" ficam indistinguíveis para quem
# consome o gateway. Folgado de propósito — aparelho desligado produz o mesmo
# silêncio de uma entrega morta.
DELIVERY_ACK_TIMEOUT_MS=900000

# ─────────────────────────────────────────────────
# Webhook (mensagens recebidas)
# ─────────────────────────────────────────────────
# URL para onde as mensagens recebidas serão encaminhadas (deixe em branco para desabilitar)
WEBHOOK_URL=

# Segredo compartilhado mandado no header x-gateway-secret (opcional).
# O webhook do gateway nao e assinado como o da Meta: sem isto, o destino nao
# tem como provar que a chamada veio daqui.
WEBHOOK_HEADER_SECRET=

# Número máximo de tentativas de envio do webhook
WEBHOOK_MAX_RETRIES=3

# Delay base entre tentativas do webhook (em ms, duplica a cada falha)
WEBHOOK_RETRY_DELAY_MS=1000

# ─────────────────────────────────────────────────
# Telegram (alertas de sessão)
# ─────────────────────────────────────────────────
# Token do bot do Telegram (deixe em branco para desabilitar alertas)
TELEGRAM_TOKEN=

# ID do chat/grupo do Telegram que receberá os alertas
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────
# Observabilidade
# ─────────────────────────────────────────────────
# Driver de log do container. Em produção use `gcplogs` para os logs saírem da
# VM e chegarem ao Cloud Logging — com `json-file` eles só existem via
# `docker logs` por SSH, que foi como as 19 desconexões da semana de 27/07 a
# 03/08/2026 passaram despercebidas.
DOCKER_LOG_DRIVER=json-file
